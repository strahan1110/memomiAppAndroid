<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oscuro">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/completelogo" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/btnIngresarNovios"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#A55A2B"
            android:text="Ingresar como Novios"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:fontFamily="@font/petrona" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="8dp" />

        <Button
            android:id="@+id/btnIngresarInvitado"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#8B6C53"
            android:text="Ingresar como Invitado"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:fontFamily="@font/petrona" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
