<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.apkMemomi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/oscuro</item>
        <item name="colorPrimaryVariant">@color/blancoscuro</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/celeste</item>
        <item name="colorSecondaryVariant">@color/tofi</item>
        <item name="colorOnSecondary">@color/toficlaro</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="android:windowBackground">@color/oscuro</item>
    </style>

    <style name="Theme.apkMemomi.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.apkMemomi.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.apkMemomi.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>